# Giveaway Bot Config
# Hướng dẫn bảo mật: Chmod 600 cho file .env thật. Không commit file .env

# Telegram Config
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_channel_or_chat_id"

# Sources Config (1 = enabled, 0 = disabled)
# ── Chuyên Giveaway Phần mềm (Windows / PC) ──
SOURCE_SHAREWAREONSALE=1
SOURCE_GIVEAWAYOFTHEDAY=1
SOURCE_TICKCOUPON=1

# ── Chuyên iOS / iPadOS / macOS (Apps Gone Free & Promo Codes) ──
SOURCE_GOTD_IOS=1
SOURCE_GOTD_MAC=1
SOURCE_9TO5TOYS_APPS=1
SOURCE_IDOWNLOADBLOG=1

# ── Trang tin công nghệ & Cộng đồng ──
SOURCE_GHACKS=1
SOURCE_BETANEWS=1
SOURCE_SOFTPEDIA=1
SOURCE_DIGITALTRENDS=1
SOURCE_MAKEUSEOF=1
SOURCE_NSANE_DEALS=1
SOURCE_COMSS=1
SOURCE_ITSFOSS=1
SOURCE_FREEAPPSFORME=1
SOURCE_GECKOANDFLY=1

# ── Game & Reddit (r/AppHookup, r/iosgaming, r/FreeGameFindings, r/eFreebies...) ──
SOURCE_STEAM_NEWRELEASES=1
SOURCE_REDDIT_RSS=1

# SQLite DB Path
DB_PATH="giveaways.db"

# Keyword Filters (cách nhau bởi dấu phẩy, để trống = lấy tất cả)
# Ví dụ: KEYWORDS="windows,ios,iphone,ipad,mac,antivirus,pdf,free"
KEYWORDS=""

# Negative Keywords - Tự động bỏ qua bài chứa từ này (giảm rác)
# Ví dụ: NEGATIVE_KEYWORDS="job,interview,hiring,resume,salary,career"
NEGATIVE_KEYWORDS="job,interview,hiring,resume,salary,career,podcast"

# Điểm tin cậy tối thiểu để gửi Telegram (0 = gửi tất cả, 50 = chỉ bài có code/deal đáng tin)
MIN_CONFIDENCE_SCORE=0

# Cấu hình Fallback Scraping (Phase 2)
# Bật/tắt tính năng cào HTML gốc nếu RSS bị thiếu (1 = bật, 0 = tắt)
ENABLE_FALLBACK_SCRAPER=1

# Cấu hình Reddit API PRAW (Phase 2 - Thay thế cho RSS nếu khai báo)
# Lấy từ https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="GiveawayBot/2.0 by /u/your_username"

# Cấu hình Telethon Listener (Phase 3 - Mặc định tắt)
# Lấy API ID & API Hash từ https://my.telegram.org/apps
ENABLE_TELETHON_LISTENER=0
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
# Danh sách các channel muốn theo dõi, phân tách bằng dấu phẩy
TELETHON_CHANNELS="@sharewareonsale,@giveawayoftheday,@apphookup"

# Cấu hình Web Admin UI & PWA (Phase 4)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme123"
WEB_PORT="5000"
